#!/usr/bin/env bash
# Configure baseline defaults in the image. Avoid applying firewall rules to the
# build host/kernel from inside a live-build chroot; activation occurs at boot.
set -euo pipefail

if command -v ufw >/dev/null 2>&1; then
  ufw default deny incoming
  ufw default allow outgoing
  if [[ -f /etc/ufw/ufw.conf ]]; then
    sed -i 's/^ENABLED=.*/ENABLED=yes/' /etc/ufw/ufw.conf
  fi
fi

# Automatic security updates.
cat > /etc/apt/apt.conf.d/20auto-upgrades <<'EOF'
APT::Periodic::Update-Package-Lists "1";
APT::Periodic::Unattended-Upgrade "1";
EOF

# Enable boot-time services without trying to start them in the chroot.
if command -v systemctl >/dev/null 2>&1; then
  systemctl enable apparmor.service 2>/dev/null || echo "WARNING: AppArmor enable deferred."
  systemctl enable auditd.service 2>/dev/null || echo "WARNING: auditd enable deferred."
  systemctl enable ufw.service 2>/dev/null || echo "WARNING: UFW enable deferred."
fi

# Harden SSH root login only when an SSH server config directory exists.
if [[ -d /etc/ssh/sshd_config.d ]]; then
  cat > /etc/ssh/sshd_config.d/99-vyron-hardening.conf <<'EOF'
PermitRootLogin no
EOF
fi

echo "VyronOS baseline policy configured (runtime verification required)."
