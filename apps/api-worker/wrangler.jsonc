{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "nexus-analytics-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-analytics",
      "database_id": "22226775-91dc-4868-acf7-52c67c723a4f",
      "migrations_dir": "../../database/d1"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "DATASET_JOBS",
        "queue": "nexus-dataset-jobs"
      }
    ],
    "consumers": [
      {
        "queue": "nexus-dataset-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "DATASETS",
      "id": "e414470b1924438ab954703d10f4edd0"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://REPLACE_WITH_FRONTEND_HOST",
    "SESSION_TTL_SECONDS": "28800"
  },
  "observability": {
    "enabled": true
  }
}
