{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "nexus-analytics-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexus-analytics",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID",
      "migrations_dir": "../../database/d1"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DATASETS",
      "bucket_name": "nexus-analytics-datasets"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://REPLACE_WITH_FRONTEND_HOST",
    "SESSION_TTL_SECONDS": "28800"
  },
  "observability": { "enabled": true }
}