# Local development: point the web app to the local Express API.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Cloudflare production: leave NEXT_PUBLIC_API_URL unset so browser requests
# use same-origin /api paths, then proxy those paths to the API Worker at build time.
# Example: https://nexus-analytics-api.<your-subdomain>.workers.dev
API_PROXY_TARGET=
