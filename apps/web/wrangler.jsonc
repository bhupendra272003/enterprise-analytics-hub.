{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nexus-analytics-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "API",
      "service": "nexus-analytics-api"
    }
  ]
}
