NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=strict
SESSION_SECRET=replace-with-at-least-32-random-bytes
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=enterprise_hub
DB_USER=hub_app
DB_PASSWORD=replace-me
INVITE_BASE_URL=http://localhost:3000/accept-invite
DATA_STORAGE_DIR=./storage/datasets

# Optional SMTP for verification and password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NEXUS Analytics <no-reply@example.com>
